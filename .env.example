# PLIFE Growth OS — Variables de entorno requeridas
# Copiá este archivo como .env.local y completá los valores reales.
# Nunca commitees .env.local — está en .gitignore.

# --- Supabase (requeridas) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Motores internos ---
# No se requiere proveedor OpenAI. Los motores internos operan sin API externa
# (modo determinístico hasta definir proveedor/tecnología). OpenAI fue removido en FASE 15B.

# --- App (requerida en producción/staging) ---
# URL pública del deploy. Usada por Supabase para emails de invite y password reset.
# En local puede omitirse. En Vercel: https://tuproyecto.vercel.app
NEXT_PUBLIC_APP_URL=

# --- Demo mode (opcional) ---
# true  → muestra badge demo, "Recorrido demo" en sidebar, datos de demostración.
# false / ausente → modo normal. No rompe nada si está ausente.
NEXT_PUBLIC_DEMO_MODE=
