# Variables para tests E2E con Playwright
# Copiar como .env.test y completar valores reales (no commitear .env.test)

# URL base del servidor de desarrollo o staging
# Si el dev server arranca en otro puerto (Next.js avisa: "using port 3001"), ajustar aquí.
E2E_BASE_URL=http://localhost:3000

# Credenciales de usuario admin con seed demo cargado
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Activar modo demo para tests de dashboard
NEXT_PUBLIC_DEMO_MODE=true
